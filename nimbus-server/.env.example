NODE_ENV=production
PORT=3000
# Dibuat melalui menu PostgreSQL Databases di cPanel.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
PG_POOL_MAX=3
SESSION_DAYS=30
PUBLIC_URL=https://cms.example.com
# Diisi melalui environment hosting atau file .env privat.
GEMINI_API_KEY=
GEMINI_MODEL=
LISTENING_API_URL=
LISTENING_API_TOKEN=
# Optional absolute directory outside public/. Defaults to storage/backups/.
MWG_BACKUP_DIR=
